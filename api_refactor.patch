+async fn log_failed_workflow_start(
+    pool: &autumn_harvest::DbPool,
+    actor: &str,
+    source: &str,
+    request_id: Option<&str>,
+    workflow_name: &str,
+    route: &str,
+    error_summary: &str,
+) {
+    if let Ok(mut conn) = acquire_conn(pool).await {
+        let ar = NewAuditRecord {
+            actor, operation: OP_WORKFLOW_START, target_type: TARGET_WORKFLOW,
+            target_id: Some(workflow_name), route_or_command: route,
+            request_id, idempotency_key: None, status: STATUS_FAILED,
+            error_summary: Some(error_summary), shard_id: None, source,
+        };
+        let _ = audit::insert_audit(&mut conn, &ar).await;
+    }
+}
