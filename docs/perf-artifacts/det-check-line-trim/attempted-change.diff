+/// Trims leading/trailing whitespace, byte-identical to [`str::trim`], with an
+/// ASCII fast path for the common case.
+///
+/// `str::trim()` dispatches through the generic `Pattern`/`Searcher`
+/// machinery for the `char::is_whitespace` predicate, which a self-scan
+/// profile of this module's own workload (`docs/perf-artifacts/
+/// det-check-line-trim/`) attributes over 5% of total instructions to
+/// (`core::str::trim_matches`) -- called once per source line from both the
+/// module-scope scan below and the per-line function-body loop it inlines.
+/// Every `cargo fmt`-formatted Rust source line is ASCII-whitespace-only at
+/// its edges, so this strips ASCII whitespace with `str::trim_ascii` first,
+/// then falls back to the general `str::trim()` only when a residual
+/// Unicode-whitespace codepoint is still sitting at an edge afterward --
+/// which can only happen for non-ASCII whitespace (`u8::is_ascii_whitespace`
+/// omits vertical tab and every non-ASCII `White_Space` codepoint that
+/// `char::is_whitespace` includes), so the result is exactly what
+/// `line.trim()` would have produced, on every input.
+#[inline]
+fn trim_line(line: &str) -> &str {
+    // `str::trim_ascii` (stable since 1.80, within this crate's 1.88 MSRV) is
+    // std's own ASCII-whitespace trim. Its internal implementation slices the
+    // result with `from_utf8_unchecked` (sound: trimming ASCII bytes off a
+    // valid UTF-8 string cannot break UTF-8 validity), skipping the
+    // char-boundary check every `&str` range index normally pays -- cheaper
+    // than an equivalent hand-rolled byte scan built from safe indexing.
+    let candidate = line.trim_ascii();
+    let bytes = candidate.as_bytes();
+    let edges_are_ascii = bytes.first().is_none_or(|&f| f < 0x80)
+        && bytes.last().is_none_or(|&l| l < 0x80);
+    if edges_are_ascii {
+        // Neither edge survived the ASCII-whitespace trim above while also
+        // being ASCII, so neither is ASCII whitespace -- and an ASCII byte is
+        // never part of a non-ASCII `White_Space` codepoint, so neither is any
+        // other kind of whitespace either. This is the common case (every
+        // `cargo fmt`-formatted line), and it skips the char-decode +
+        // `is_whitespace` table lookup below entirely.
+        return candidate;
+    }
+    // Rare: a non-ASCII byte sits at an edge. Only then pay for a real
+    // decode + `char::is_whitespace` check.
+    let edge_has_unicode_ws = candidate.chars().next().is_some_and(char::is_whitespace)
+        || candidate.chars().next_back().is_some_and(char::is_whitespace);
+    if edge_has_unicode_ws {
+        candidate.trim()
+    } else {
+        candidate
+    }
+}
