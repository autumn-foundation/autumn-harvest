+/// Issue #2248: the claim split and the persist phases as `key=value` fields.
+fn split_fields(samples: &Samples) -> String {
+    let mut fields = Vec::new();
+    for (kind, values) in ClaimKind::ALL.iter().zip(&samples.claim_kind) {
+        fields.push(signal_fields(&format!("claim_{}", kind.as_str()), values));
+    }
+    for (phase, values) in PersistPhase::ALL.iter().zip(&samples.phase) {
+        fields.push(signal_fields(&format!("phase_{}", phase.as_str()), values));
+    }
+    for (kind, values) in ClaimKind::ALL.iter().zip(&samples.take_kind) {
+        fields.push(signal_fields(&format!("take_{}", kind.as_str()), values));
+    }
+    fields.join(" ")
+}
