services:
  postgres:
    image: postgres:16
    environment:
      POSTGRES_USER: {{ident}}
      POSTGRES_PASSWORD: {{ident}}
      POSTGRES_DB: {{ident}}
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ident}}"]
      interval: 5s
      timeout: 5s
      retries: 5

volumes:
  postgres_data:
