{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "database",
    "probes",
    "drain",
    "migrations"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-f]{64})$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "database": {
      "type": "object",
      "required": [
        "existingSecret",
        "secretKey"
      ],
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "probes": {
      "type": "object",
      "required": [
        "basePath",
        "liveness",
        "readiness",
        "startup"
      ],
      "properties": {
        "basePath": {
          "type": "string",
          "pattern": "^(/[^/].*[^/]|/[^/])?$"
        },
        "liveness": {
          "$ref": "#/definitions/probe"
        },
        "readiness": {
          "$ref": "#/definitions/probe"
        },
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "additionalProperties": false
    },
    "drain": {
      "type": "object",
      "required": [
        "preStopSleepSeconds",
        "shutdownSeconds",
        "terminationGracePeriodSeconds"
      ],
      "properties": {
        "preStopSleepSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "shutdownSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "migrations": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "checkOnStart": {
          "type": "boolean"
        },
        "includeDirs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string"
        },
        "serviceAccountName": {
          "type": "string"
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 0
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^[0-9]+%$"
            }
          ]
        }
      }
    },
    "strategy": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "RollingUpdate",
            "Recreate"
          ]
        },
        "rollingUpdate": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "env": {
      "type": "array"
    },
    "envFrom": {
      "type": "array"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
