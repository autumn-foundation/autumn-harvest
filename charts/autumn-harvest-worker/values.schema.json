{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "database", "probes", "drain", "migrations"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "command": { "type": "array", "items": { "type": "string" } },
    "args": { "type": "array", "items": { "type": "string" } },
    "profile": { "type": "string", "minLength": 1 },
    "database": {
      "type": "object",
      "required": ["existingSecret", "secretKey"],
      "properties": {
        "existingSecret": { "type": "string" },
        "secretKey": { "type": "string", "minLength": 1 }
      }
    },
    "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "probes": {
      "type": "object",
      "required": ["basePath", "liveness", "readiness"],
      "properties": {
        "basePath": { "type": "string", "pattern": "^(/[^/].*[^/]|/[^/])?$" },
        "liveness": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" }
      }
    },
    "drain": {
      "type": "object",
      "required": ["preStopSleepSeconds", "shutdownSeconds", "terminationGracePeriodSeconds"],
      "properties": {
        "preStopSleepSeconds": { "type": "integer", "minimum": 1 },
        "shutdownSeconds": { "type": "integer", "minimum": 0 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "migrations": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "checkOnStart": { "type": "boolean" },
        "includeDirs": { "type": ["array", "null"], "items": { "type": "string" } },
        "existingSecret": { "type": "string" },
        "secretKey": { "type": "string" },
        "serviceAccountName": { "type": "string" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "properties": {
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
